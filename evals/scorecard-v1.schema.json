{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/rebuild-labs/evals/scorecard-v1.schema.json",
  "title": "Rebuild Labs planning scorecard version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "acceptable_modes",
    "required_observations",
    "required_decisions",
    "anti_findings",
    "safety_requirements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "acceptable_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "complete_rebuild",
          "incremental_rebuild",
          "combined_rebuild",
          "ordinary_refactor",
          "defer",
          "investigate"
        ]
      }
    },
    "required_observations": {"$ref": "#/$defs/nonEmptyStrings"},
    "required_decisions": {"$ref": "#/$defs/nonEmptyStrings"},
    "anti_findings": {"$ref": "#/$defs/nonEmptyStrings"},
    "safety_requirements": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    }
  }
}
